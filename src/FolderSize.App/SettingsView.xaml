<UserControl x:Class="FolderSize.App.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="8" MaxWidth="680" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Make FolderSize feel at home on your desktop."
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Label Content="_Theme" Target="{Binding ElementName=ThemeBox}" Padding="0,0,0,8"/>
            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Left" Width="280"
                      AutomationProperties.Name="App theme"/>
            <TextBlock Text="System follows your Windows light or dark setting."
                       TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
            <CheckBox x:Name="OpenWithDoubleClickBox" Content="Open with Double Click" Margin="0,24,0,0"
                      AutomationProperties.Name="Open with Double Click"/>
            <TextBlock Text="Open files with their Windows default action in all file lists. Executables, scripts, installers, and shortcuts are blocked. Folder navigation is unchanged."
                       TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
            <CheckBox x:Name="StartScanningOnOpenBox" Content="Start scanning when app is opened" Margin="0,24,0,0"
                      AutomationProperties.Name="Start scanning when app is opened"/>
            <TextBlock Text="Scan automatically on launch. Uses the folder supplied by Explorer or the command line, otherwise the folder shown in the path box."
                       TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
        <TextBlock x:Name="SaveStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,16,0,20"
                   Text="Changes apply immediately and are saved for future launches."
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
    </ScrollViewer>
</UserControl>
