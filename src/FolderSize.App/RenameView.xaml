<UserControl x:Class="FolderSize.App.RenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel IsEnabled="{Binding Idle}" Margin="0,0,0,2">
            <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding ScopePath}" ToolTip="{Binding ScopePath}" Width="180"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Content="Include scanned subfolders" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="Files:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="RenameFilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="110"
                     Padding="5,3" ToolTip="Filename filters, for example *.pdf or *.txt;*.jpg" AutomationProperties.Name="Rename file filter"/>
            <Button x:Name="DetectPatternButton" Content="Detect pattern" IsEnabled="{Binding CanDetectPattern}" Click="DetectPattern_Click" Padding="8,3" Margin="10,0,0,0"
                    ToolTip="Suggest rules from the filtered filenames. Files are not changed until Apply."/>
        </WrapPanel>
        <DockPanel Grid.Row="1" IsEnabled="{Binding Idle}" Margin="0,0,0,2">
            <ComboBox x:Name="RenameRuleBox" ItemsSource="{Binding RuleNames}" SelectedIndex="{Binding RuleIndex}"
                      Width="220" Margin="0,0,10,0" VerticalAlignment="Top" AutomationProperties.Name="Rename rule"/>
            <Grid>
                <WrapPanel>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding RuleIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="RenameFindBox" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="5,3" Margin="0,0,8,0" AutomationProperties.Name="Find text"/>
                    <TextBlock Text="Replace" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="5,3" Margin="0,0,8,0" AutomationProperties.Name="Replacement text"/>
                    <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" VerticalAlignment="Center"/>
                </WrapPanel>
                <ComboBox ItemsSource="{Binding CaseNames}" SelectedIndex="{Binding CaseIndex}" Width="160"
                          HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Capitalisation">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding RuleIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
                <WrapPanel>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding RuleIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <TextBlock Text="Prefix" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="5,3" Margin="0,0,8,0" AutomationProperties.Name="Numbering prefix"/>
                    <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="5,3" Margin="0,0,8,0" AutomationProperties.Name="Starting number"/>
                    <TextBlock Text="Digits" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}" Width="40" Padding="5,3" AutomationProperties.Name="Number padding"/>
                </WrapPanel>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding RuleIndex}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pattern" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="RenamePatternBox" Grid.Column="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" Margin="0,0,8,0"
                             AutomationProperties.Name="Extraction pattern" ToolTip="Regular expression with named groups, e.g. ^(?&lt;text&gt;.*?)(?&lt;number&gt;\d+)$"/>
                    <TextBlock Grid.Column="2" Text="Format" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="RenameFormatBox" Grid.Column="3" Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" Padding="5,3" Margin="0,0,8,0"
                             AutomationProperties.Name="Rename format" ToolTip="Named groups in braces; numeric padding: {number:00}. Built-ins: {name}, {n:000}."/>
                    <CheckBox Grid.Column="4" Content="Ignore case" IsChecked="{Binding IgnoreCase}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </DockPanel>
        <TextBlock x:Name="RenameStatusText" Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="42" Margin="0,0,0,2"
                   AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Status}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DataGrid x:Name="RenameGrid" Grid.Row="3" ItemsSource="{Binding Rows}" IsEnabled="{Binding Idle}"
                  AutomationProperties.Name="Rename preview">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Apply" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                <DataGridTextColumn Header="Original name" Binding="{Binding OriginalName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Proposed name (editable)" Binding="{Binding ProposedName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="170"/>
                <DataGridTextColumn Header="Full path" Binding="{Binding FullPath}" IsReadOnly="True" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,4,0,0">
            <WrapPanel>
                <Button x:Name="ApplyRenameButton" Content="Apply selected..." IsEnabled="{Binding CanApply}" Click="Apply_Click" Padding="10,5" Margin="0,0,6,0"/>
                <Button x:Name="MoveConflictsButton" Content="Move conflicts" IsEnabled="{Binding CanMoveConflicts}" Click="MoveConflicts_Click" Padding="10,5" Margin="0,0,6,0"/>
                <Button x:Name="UndoRenameButton" Content="Undo last rename..." IsEnabled="{Binding CanUndo}" Click="Undo_Click" Padding="10,5" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}" Width="100"
                          IsEnabled="{Binding Idle}" Margin="0,0,6,0" ToolTip="Load a saved preset" AutomationProperties.Name="Saved rename preset"/>
                <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" Width="100" Padding="5,3"
                         IsEnabled="{Binding Idle}" Margin="0,0,6,0" ToolTip="Preset name" AutomationProperties.Name="Rename preset name"/>
                <Button Content="Save preset" Click="SavePreset_Click" IsEnabled="{Binding Idle}" Padding="10,5" Margin="0,0,6,0"/>
            </WrapPanel>
            <TextBlock TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,2,0,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="HistoryStatus"/>
                        <Binding Path="PresetStatus"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
