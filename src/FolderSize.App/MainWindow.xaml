<Window x:Class="FolderSize.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FolderSize.App"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="FolderSize" Icon="Assets/FolderSize.ico" Height="820" Width="1240" MinWidth="820" MinHeight="640"
        ThemeMode="System" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" UseLayoutRounding="True"
        Closing="Window_Closing" SizeChanged="Window_SizeChanged" PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedDuplicates" Source="{Binding DuplicateRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="ContextMenuIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <ContextMenu x:Key="FileContextMenu" x:Shared="False" Opened="FileContextMenu_Opened">
            <MenuItem Header="Open" Click="ContextOpen_Click" ToolTipService.ShowOnDisabled="True">
                <MenuItem.Icon><TextBlock Style="{StaticResource ContextMenuIcon}" Text="&#xE8E5;"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Copy filename" Click="ContextCopyName_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource ContextMenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy full path" Click="ContextCopyPath_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource ContextMenuIcon}" Text="&#xE71B;"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Click="ContextSearchFolder_Click" ToolTipService.ShowOnDisabled="True">
                <MenuItem.Header><TextBlock Text="Search folder on internet"/></MenuItem.Header>
                <MenuItem.Icon><TextBlock Style="{StaticResource ContextMenuIcon}" Text="&#xE721;"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Send to Recycle Bin" Click="ContextRecycle_Click" ToolTipService.ShowOnDisabled="True">
                <MenuItem.Icon><TextBlock Style="{StaticResource ContextMenuIcon}" Text="&#xE74D;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="FileRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <Setter Property="ContextMenu" Value="{StaticResource FileContextMenu}"/>
        </Style>
        <ContextMenu x:Key="EmptyFolderContextMenu" x:Shared="False" Opened="EmptyFolderContextMenu_Opened">
            <MenuItem Header="Open in Explorer" Click="OpenEmptyFolderInExplorer_Click">
                <MenuItem.Icon><TextBlock Style="{StaticResource ContextMenuIcon}" Text="&#xE8B7;"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="EmptyFolderRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
            <Setter Property="ContextMenu" Value="{StaticResource EmptyFolderContextMenu}"/>
        </Style>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextFillColorSecondary}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardBackgroundFillColorDefault}"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource CardStrokeColorDefault}"/>
        <Style x:Key="NavigationLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Width, ElementName=NavigationPane}" Value="56">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavigationIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
            <Setter Property="DockPanel.Dock" Value="Top"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Border x:Name="ActiveIndicator" Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="primitives:DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6,6,0,0" Margin="0,0,4,0" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Border x:Name="ActiveIndicator" Height="3" Margin="8,0"
                                        VerticalAlignment="Bottom" CornerRadius="1"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="NavigationPane" Width="216" Margin="0,8,0,0">
            <ListBox x:Name="MainNavigation" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavigationItem}"
                     SelectedIndex="0" SelectionChanged="MainNavigation_SelectionChanged"
                     AutomationProperties.Name="Main navigation"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Contained">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel LastChildFill="True"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem ToolTip="Space usage" AutomationProperties.Name="Space usage">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="Space usage" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem ToolTip="Duplicates" AutomationProperties.Name="Duplicates">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="Duplicates" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem ToolTip="Large Files" AutomationProperties.Name="Large Files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="Large Files" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem ToolTip="Empty Folders" AutomationProperties.Name="Empty Folders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="Empty Folders" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem ToolTip="Rename" AutomationProperties.Name="Rename">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AC;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="Rename" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem ToolTip="{Binding IssueHeader}" AutomationProperties.Name="{Binding IssueHeader}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="{Binding IssueHeader}" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="SettingsNavigationItem" DockPanel.Dock="Bottom" ToolTip="Settings"
                             AutomationProperties.Name="Settings" IsEnabled="{Binding Idle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource NavigationIcon}"/>
                        <TextBlock Text="Settings" Style="{StaticResource NavigationLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="DiskCleanupNavigationItem" DockPanel.Dock="Bottom" Focusable="False">
                    <ListBoxItem.Template>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </ListBoxItem.Template>
                    <Button x:Name="DiskCleanupButton" Click="DiskCleanup_Click"
                            ToolTip="Launch Disk Clean-up" AutomationProperties.Name="Launch Disk Clean-up"
                            Padding="12,0" Margin="0,2" MinHeight="44"
                            HorizontalContentAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE74D;" Style="{StaticResource NavigationIcon}"/>
                            <TextBlock Grid.Column="1" Text="Launch Disk Clean-up" TextWrapping="Wrap"
                                       Style="{StaticResource NavigationLabel}"/>
                        </Grid>
                    </Button>
                </ListBoxItem>
                <ListBoxItem x:Name="DrivesNavigationItem" Focusable="False" MinHeight="0" Padding="0" Margin="0,8,0,8">
                    <ListBoxItem.Template>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </ControlTemplate>
                    </ListBoxItem.Template>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DrivesHeading" Text="Drives" FontWeight="SemiBold" Margin="12,0,0,0"
                                       Style="{StaticResource NavigationLabel}"/>
                            <Button x:Name="RefreshDrivesButton" Grid.Column="1" Click="RefreshDrives_Click"
                                    Width="32" Height="32" Padding="2" Margin="0,0,4,0"
                                    ToolTip="Refresh drives" AutomationProperties.Name="Refresh drives">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource NavigationIcon}" FontSize="16"/>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding DriveStatus}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Style="{StaticResource NavigationLabel}" Margin="12,0,12,0"/>
                        <ListBox x:Name="DrivesList" Grid.Row="2" ItemsSource="{Binding Drives}"
                                 Background="Transparent" BorderThickness="0" IsEnabled="{Binding Idle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Drives" ToolTip="{Binding DriveStatus}"
                                 MouseDoubleClick="DrivesList_DoubleClick" KeyDown="DrivesList_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItem}">
                                    <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip}"/>
                                    <Setter Property="IsEnabled" Value="{Binding CanScan}"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource NavigationIcon}"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Width, ElementName=NavigationPane}" Value="56">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SpaceText}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,5,0,0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="#0078D4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowOnSpace}" Value="True">
                                                                <Setter Property="Foreground" Value="#D13438"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CanScan}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </ListBoxItem>
            </ListBox>
        </Border>
    <Grid Grid.Column="1" Margin="12,8,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Image Source="Assets/OpenMoji-1F5C3.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FolderSize" FontSize="24" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Padding="12">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=SettingsTab}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding Idle}" VerticalContentAlignment="Center" Padding="8,6" Margin="0,0,8,0"
                     AutomationProperties.Name="Folder path" ToolTip="Choose a folder to scan" KeyDown="FolderBox_KeyDown"/>
            <Button Grid.Column="1" Content="Browse..." Click="Browse_Click" IsEnabled="{Binding Idle}"/>
            <CheckBox x:Name="IncludeSubfoldersBox" Grid.Column="2" Content="Include subfolders"
                      IsChecked="{Binding Recursive}" Click="IncludeSubfolders_Click"
                      IsEnabled="{Binding Idle}" VerticalAlignment="Center" Margin="4,0,18,0"/>
            <Button x:Name="ScanButton" Grid.Column="3" Content="Scan" Style="{StaticResource PrimaryButton}"
                    Click="Scan_Click" IsEnabled="{Binding Idle}"/>
            <Button Grid.Column="4" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding Busy}" Margin="0"/>
        </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding Summary}" Margin="2,10" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=SettingsTab}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TabControl x:Name="MainSections" Grid.Row="3" Background="Transparent" SelectedIndex="0"
                    SelectionChanged="MainSections_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <!-- Keep native selection and Ctrl+Tab without showing top-level tab headers. -->
                        <ItemsPresenter Height="0" Visibility="Hidden"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                          KeyboardNavigation.TabNavigation="Local"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Space usage">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" IsEnabled="{Binding Idle}">
                            <Button Content="Up" Click="Up_Click" ToolTip="Go to the parent folder"/>
                            <Button Content="Scan root" Click="Root_Click" ToolTip="Return to the root of the current scan"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"
                                   ToolTip="{Binding CurrentPath}"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Files &amp; folders" Style="{StaticResource SectionHeading}" Margin="4,0,0,12"/>
                        <DataGrid x:Name="UsageGrid" ItemsSource="{Binding Rows}" IsReadOnly="True"
                                  Grid.Row="1"
                                  SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="UsageGrid_SelectionChanged"
                                  MouseDoubleClick="UsageGrid_DoubleClick" KeyDown="UsageGrid_KeyDown"
                                  IsEnabled="{Binding Idle}" AutomationProperties.Name="Folder contents">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="4,0" VerticalAlignment="Center">
                                                <local:FileTypeIcon Row="{Binding}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="60"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="125"/>
                                <DataGridTemplateColumn Header="Share" SortMemberPath="Percent" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,1">
                                                <TextBlock Text="{Binding Percent, StringFormat={}{0:F1}%}" FontSize="11" Margin="0,0,0,3"/>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="3"
                                                             AutomationProperties.Name="Share of folder size"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource FileRowStyle}">
                                    <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                        </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                                      Background="Transparent" ShowsPreview="True"/>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock Text="Space map" Style="{StaticResource SectionHeading}"/>
                                </DockPanel>
                                <TabControl x:Name="SpaceMapTabs" Grid.Row="1" Background="Transparent">
                                    <TabItem Header="Folders">
                                        <local:TreemapView x:Name="Map" Node="{Binding Current}" IsEnabled="{Binding Idle}"
                                                           Background="{DynamicResource CardBrush}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                           SelectionBrush="{DynamicResource WindowForeground}"/>
                                    </TabItem>
                                    <TabItem Header="By extension">
                                        <local:TreemapView x:Name="ExtensionMap" Items="{Binding MapGroups.Extensions}"
                                                           Background="{DynamicResource CardBrush}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </TabItem>
                                    <TabItem Header="By kind">
                                        <local:TreemapView x:Name="KindMap" Items="{Binding MapGroups.Kinds}"
                                                           Background="{DynamicResource CardBrush}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </TabItem>
                                </TabControl>
                                <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Groups include all scanned files under the current folder. Hover for size."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=SpaceMapTabs}" Value="0">
                                                    <Setter Property="Text" Value="Select to highlight. Double-click a folder to explore."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="DuplicatesTab" Header="Duplicates">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Find duplicates" Click="Find_Click" IsEnabled="{Binding CanFind}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Recycle selected..." Click="Recycle_Click" IsEnabled="{Binding CanRecycle}"/>
                        <Button Content="Clear selection" Click="ClearSelection_Click" IsEnabled="{Binding Idle}"/>
                        <Button x:Name="InvertSelectionButton" Content="Invert selection" Click="InvertSelection_Click" IsEnabled="{Binding Idle}"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding DuplicateSummary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <DataGrid x:Name="DuplicatesGrid" Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedDuplicates}}"
                              RowStyle="{StaticResource FileRowStyle}"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ScrollViewer.CanContentScroll="True"
                              MouseDoubleClick="FileGrid_DoubleClick"
                              IsEnabled="{Binding Idle}" AutomationProperties.Name="Exact duplicate files">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                            CornerRadius="6" Margin="0,6,0,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <!-- Expander peers can hang WPF automation updates during virtualised group scrolling. -->
                                                            <primitives:ToggleButton x:Name="PART_Header" Padding="8"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}"
                                                                    AutomationProperties.Name="{Binding Name.Name}"
                                                                    AutomationProperties.HelpText="{Binding Name.Summary}">
                                                                <primitives:ToggleButton.Template>
                                                                    <ControlTemplate TargetType="primitives:ToggleButton">
                                                                        <Border x:Name="HeaderBorder" Padding="{TemplateBinding Padding}"
                                                                                Background="{DynamicResource CardBrush}"
                                                                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="24"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE76C;"
                                                                                           Style="{StaticResource NavigationIcon}"/>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="HeaderBorder" Property="Background"
                                                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="HeaderBorder" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </primitives:ToggleButton.Template>
                                                                <Grid Margin="4,8,8,8" ToolTip="{Binding Name.Summary}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="24"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource NavigationIcon}"/>
                                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding Name.Name}" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Name.Summary}" FontSize="12" TextWrapping="Wrap"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </primitives:ToggleButton>
                                                            <ItemsPresenter Grid.Row="1">
                                                                <ItemsPresenter.Style>
                                                                    <Style TargetType="ItemsPresenter">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Name.IsExpanded}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ItemsPresenter.Style>
                                                            </ItemsPresenter>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Recycle" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Full path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="All but the first copy in each group are selected by default. Review your selection and keep at least one per group. Contents are rechecked before recycling. Local fixed drives only; permanent deletion is never used."/>
                </Grid>
                </Border>
            </TabItem>
            <TabItem x:Name="LargeFilesTab" Header="Large Files">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <Label Content="Minimum size" Target="{Binding ElementName=LargeFileSizeBox}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="LargeFileSizeBox" Width="130" Padding="8,6" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" IsEnabled="{Binding Idle}"
                                     Text="{Binding LargeFileSize, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Minimum file size" KeyDown="LargeFileSize_KeyDown"/>
                            <ComboBox x:Name="LargeFileUnitBox" Width="80" Margin="0,0,12,0"
                                      IsEnabled="{Binding Idle}" SelectedValuePath="Content"
                                      SelectedValue="{Binding LargeFileUnit, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="File size unit">
                                <ComboBoxItem Content="kb"/>
                                <ComboBoxItem Content="mb"/>
                                <ComboBoxItem Content="gb"/>
                                <ComboBoxItem Content="tb"/>
                            </ComboBox>
                            <Button x:Name="ShowLargeFilesButton" Content="Show files" Click="ShowLargeFiles_Click"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanFind}"/>
                            <Button x:Name="RecycleLargeFilesButton" Content="Recycle selected..."
                                    Click="RecycleLargeFiles_Click" IsEnabled="{Binding CanRecycleLargeFiles}"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Text="{Binding LargeFilesSummary}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <DataGrid x:Name="LargeFilesGrid" Grid.Row="2" ItemsSource="{Binding LargeFiles}"
                                  RowStyle="{StaticResource FileRowStyle}"
                                  MouseDoubleClick="FileGrid_DoubleClick"
                                  IsEnabled="{Binding Idle}" AutomationProperties.Name="Large files">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Recycle" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="200" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="4,0" VerticalAlignment="Center">
                                                <local:FileTypeIcon Row="{Binding}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Full path" Binding="{Binding FullPath}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="140" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="Uses the entire completed scan; units use 1024 (1 kb = 1024 bytes). Tick files to recycle, then review the confirmation. No duplicate copy is required or kept. Local fixed drives only; permanent deletion is never used."/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem x:Name="EmptyFoldersTab" Header="Empty Folders">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="FindEmptyFoldersButton" Content="Find empty folders"
                                    Click="FindEmptyFolders_Click" IsEnabled="{Binding CanFindEmptyFolders}"
                                    Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="SelectAllEmptyFoldersButton" Content="Select All"
                                    Click="SelectAllEmptyFolders_Click" IsEnabled="{Binding CanFindEmptyFolders}"/>
                            <Button x:Name="InvertEmptyFoldersSelectionButton" Content="Invert Selection"
                                    Click="InvertEmptyFoldersSelection_Click" IsEnabled="{Binding CanFindEmptyFolders}"/>
                            <Button x:Name="RecycleEmptyFoldersButton" Content="Recycle selected..."
                                    Click="RecycleEmptyFolders_Click" IsEnabled="{Binding CanRecycleEmptyFolders}"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Text="{Binding EmptyFoldersSummary}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <DataGrid x:Name="EmptyFoldersGrid" Grid.Row="2" ItemsSource="{Binding EmptyFolders}"
                                  RowStyle="{StaticResource EmptyFolderRowStyle}"
                                  IsEnabled="{Binding Idle}" AutomationProperties.Name="Empty folder trees"
                                  MouseDoubleClick="EmptyFoldersGrid_DoubleClick" KeyDown="EmptyFoldersGrid_KeyDown">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Recycle"
                                    Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="180" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="4,0" VerticalAlignment="Center">
                                                <local:FileTypeIcon Row="{Binding IconRow}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Full path" Binding="{Binding FullPath}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Empty subfolders" SortMemberPath="EmptySubfolderCount"
                                    Binding="{Binding EmptySubfolderCount, StringFormat={}{0:N0}}" Width="140" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Only the highest empty folder in each tree is listed; Empty subfolders counts all descendants included when recycling. Any file, including a zero-byte file, means not empty. Contents are rechecked before recycling. Local fixed drives only; permanent deletion is never used."/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem x:Name="RenameTab" Header="Rename">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12">
                    <local:RenameView x:Name="RenamePanel" DataContext="{Binding Rename}"/>
                </Border>
            </TabItem>
            <TabItem Header="{Binding IssueHeader}">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DataGrid ItemsSource="{Binding Issues}" IsReadOnly="True" AutomationProperties.Name="Scan and operation issues">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="Settings" IsEnabled="{Binding Idle}">
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <ContentControl x:Name="SettingsContent" IsEnabled="{Binding Idle}"/>
                </Border>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar Height="3" IsIndeterminate="{Binding Busy}" BorderThickness="0" AutomationProperties.Name="Operation progress"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="AppInfoText" Grid.Column="1" Margin="16,0,0,0"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
        </StackPanel>
    </Grid>
    </Grid>
</Window>
